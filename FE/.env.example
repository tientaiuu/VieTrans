# Public URL of the FastAPI backend server. Do not put secrets in VITE_* vars.
VITE_API_URL=http://localhost:8000

# Google Sign-In OAuth client ID (same Web client ID configured in backend)
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Only enable locally if you intentionally want to display dev reset links
VITE_SHOW_RESET_TOKEN=false
