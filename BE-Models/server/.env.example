# MongoDB configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB=vietrans

# Security key for JWT signing
SECRET_KEY=your_jwt_secret_key_here

# Email configuration for password reset
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=your-email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# Frontend origins allowed to call this backend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Remote inference Space. The backend does not load OCR/NLLB/rendering models.
VIETRANS_SPACE_URL=https://masterdzzzz-vietrans-modelspace.hf.space
VIETRANS_SPACE_API_NAME=/translate
VIETRANS_SPACE_DOWNLOAD_TIMEOUT=60

# Optional Hugging Face token for private Spaces or better quota.
HF_TOKEN=your_huggingface_access_token_here
