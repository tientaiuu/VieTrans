# MongoDB Configuration
# Replace with your local mongodb URI or Atlas cluster URI
MONGO_URI=mongodb://localhost:27017
MONGO_DB=vietrans

# DebackX worker gateway
IIMT_WORKER_URL=http://localhost:8081
IIMT_WORKER_TIMEOUT_SECONDS=300
VIETRANS_MAX_UPLOAD_MB=20
VIETRANS_RUNTIME_DIR=/app/outputs/gateway
AUTH_ENABLED=true

# Security Key for JWT signing
SECRET_KEY=your_jwt_secret_key_here

# Email Configuration (for password reset functionality)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=your-email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
