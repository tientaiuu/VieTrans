# MongoDB configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB=vietrans

# Runtime mode: use production in deployed environments
ENVIRONMENT=development

# Security key for JWT signing
SECRET_KEY=replace_with_a_long_random_secret_32_chars_or_more

# Google Sign-In OAuth client ID (Web application client)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Email configuration for password reset
RESET_TOKEN_TTL_SECONDS=3600
ALLOW_DEV_RESET_TOKEN=false

# Recommended on Hugging Face Spaces: send email through HTTPS instead of SMTP.
RESEND_API_KEY=
RESEND_FROM=VieTrans <noreply@your-domain.com>
RESEND_API_URL=https://api.resend.com/emails

# SMTP fallback, useful locally or on hosts that allow outbound SMTP.
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=your-email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Frontend origins allowed to call this backend
ALLOWED_ORIGINS=https://your-frontend.example.com,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
FRONTEND_BASE_URL=https://your-frontend.example.com

# Upload/request guardrails
MAX_IMAGE_BYTES=10485760
MAX_EDITED_IMAGE_BYTES=10485760
MAX_REQUEST_BYTES=16777216
MAX_IMAGE_PIXELS=25000000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
LIVE_RESULT_TTL_SECONDS=86400
MAX_CONCURRENT_SPACE_CALLS=3
UPLOAD_JOB_WORKERS=3

# Remote inference Space. The backend does not load OCR/NLLB/rendering models.
VIETRANS_SPACE_URL=https://your-model-space.hf.space
VIETRANS_SPACE_API_NAME=/translate
VIETRANS_SPACE_DOWNLOAD_TIMEOUT=60

# Optional Hugging Face token for private Spaces or better quota.
VIETRANS_SPACE_TOKEN=
HF_TOKEN=
