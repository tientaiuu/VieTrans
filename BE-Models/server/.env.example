# MongoDB Configuration
# Replace with your local mongodb URI or Atlas cluster URI
MONGO_URI=mongodb://localhost:27017
MONGO_DB=vietrans

# Security Key for JWT signing
SECRET_KEY=your_jwt_secret_key_here

# Email Configuration (for password reset functionality)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=your-email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# ─── Modified-DebackX Pipeline Configuration ─────────────────────────────────
# Path to fine-tuned NLLB model directory (local path or HuggingFace model ID)
# Local: D:/models/mt-nllb-1p3b-en-vi/best   (NLLB 1.3B, recommended)
# Local: D:/models/mt-nllb-en-vi/best         (NLLB 600M, faster)
# Remote: facebook/nllb-200-1.3B              (download from HuggingFace Hub)
NLLB_MODEL_PATH=D:/models/mt-nllb-1p3b-en-vi/best

# NLLB language codes (default: English → Vietnamese)
NLLB_SRC_LANG=eng_Latn
NLLB_TGT_LANG=vie_Latn

# OCR confidence threshold (0.0 - 1.0, lower = detect more text, may include noise)
OCR_MIN_CONFIDENCE=0.5

# (Optional) Custom font path for Vietnamese text rendering
# Leave blank to auto-detect system font (DejaVu, Arial, etc.)
RENDER_FONT_PATH=
