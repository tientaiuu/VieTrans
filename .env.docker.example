VIETRANS_FRONTEND_PORT=5173
VIETRANS_GATEWAY_PORT=8001
MONGO_PORT=27017
MONGO_DB=vietrans

# DebackX worker URL. If DebackX runs on the host machine, keep this value.
IIMT_WORKER_URL=http://host.docker.internal:8081
IIMT_WORKER_TIMEOUT_SECONDS=300
VIETRANS_MAX_UPLOAD_MB=20

AUTH_ENABLED=true
SECRET_KEY=replace-with-a-long-random-secret

# Optional SMTP settings for password reset.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
