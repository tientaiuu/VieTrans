WEB_PORT=80
MONGO_DB=vietrans
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=<app-name>

# Keep empty when web and API are served from the same domain through Nginx.
VITE_API_URL=

# DebackX worker URL. Use the public/private URL of the GPU worker host.
IIMT_WORKER_URL=https://debackx-worker.example.com
IIMT_WORKER_TIMEOUT_SECONDS=300
IIMT_WORKER_MODE=async
IIMT_WORKER_POLL_INTERVAL_SECONDS=2
IIMT_WORKER_API_KEY=
VIETRANS_MAX_UPLOAD_MB=20

AUTH_ENABLED=true
SECRET_KEY=replace-with-a-long-random-secret

# Optional SMTP settings for password reset.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
